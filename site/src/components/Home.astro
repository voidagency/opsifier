---
import { Image } from "astro:assets";
import deployments from "../assets/deployments.png";
import overview from "../assets/overview.png";
import { content, type Locale, REPOSITORY } from "../content";
import Sprite from "./Sprite.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

const pictograms: Record<string, string> = {
  app: '<rect x="3" y="4" width="18" height="16"/><path d="M3 10H21"/><path d="M6 7H10" stroke="#E3A33A"/>',
  postgres:
    '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6V18C4 19.66 7.58 21 12 21S20 19.66 20 18V6"/><path d="M12 9V21M4 14.5H20"/>',
  compose:
    '<rect x="9" y="3" width="6" height="6"/><rect x="3" y="15" width="6" height="6"/><rect x="15" y="15" width="6" height="6"/><path d="M12 9V12M6 15V12H18V15" stroke="#E3A33A"/>',
  template:
    '<rect x="3" y="3" width="18" height="18"/><path d="M3 9H21M10 9V21"/><path d="M6.5 12.5V17.5" stroke="#E3A33A"/>',
  box: '<path d="M12 3 20 7.5V16.5L12 21 4 16.5V7.5Z"/><path d="M4 7.5 12 12 20 7.5"/><path d="M12 12V21" stroke="#E3A33A"/>',
  schedule:
    '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12L15.5 14"/><path d="M10 3.2A9 9 0 0 1 14 3.2" stroke="#E3A33A"/>',
};

// The board is drawn here, so that its first frame is right before any script has run.
type State = "failed" | "degraded" | "unknown" | "stopped" | "progress" | "running";
const STATES: ReadonlyArray<readonly [State, number]> = [
  ["failed", 0.035],
  ["degraded", 0.05],
  ["unknown", 0.08],
  ["stopped", 0.12],
  ["progress", 0.2],
  ["running", 0.515],
];
function generator(seed: number) {
  let s = seed;
  return () => {
    s = (s + 0x6d2b79f5) | 0;
    let m = Math.imul(s ^ (s >>> 15), 1 | s);
    m = (m + Math.imul(m ^ (m >>> 7), 61 | m)) ^ m;
    return ((m ^ (m >>> 14)) >>> 0) / 4294967296;
  };
}
const random = generator(20261109);
const pick = (value: number): State => {
  let total = 0;
  for (const [state, weight] of STATES) {
    total += weight;
    if (value < total) {
      return state;
    }
  }
  return "running";
};
const lamps = Array.from({ length: 14 * 9 }, () => {
  const state = pick(random());
  const start = Math.round((0.04 + random() * 0.62) * 1000);
  return { state, start, end: start + Math.round((0.08 + random() * 0.12) * 1000) };
});
const count = (state: State) => lamps.filter((lamp) => lamp.state === state).length;
const orderedStates = ["failed", "degraded", "unknown", "progress", "running", "stopped"] as const;
const problems = count("failed") + count("degraded") + count("unknown");
const percent = Math.round((count("running") / lamps.length) * 100);

const lastSpace = t.hero.question.lastIndexOf(" ");
const questionTop = t.hero.question.slice(0, lastSpace);
const questionEnd = t.hero.question.slice(lastSpace + 1);

const commands = [
  "opsifier status",
  "opsifier logs shop/web --since 1h --level error",
  "opsifier deploy shop/web",
  "opsifier deployments shop/web",
];
// Two lines, so that the copy button never sits on the end of a wrapped one.
const install = "curl -fsSL https://raw.githubusercontent.com/voidagency/opsifier/main/scripts/install.sh \\\n  | sudo bash";
const start = "git clone https://github.com/voidagency/opsifier\ncd opsifier\nbun install\nbun run dev";
---

<Sprite />

<section class="stage" data-stage>
  <div class="stage__pin wrap">
    <h1 class="question">{questionTop} <br />{questionEnd}</h1>
    <div class="hero-copy">
      <p class="lead">{t.hero.lead}</p>
      <div class="actions">
        <a class="btn btn--amber" href={REPOSITORY} rel="noopener">
          {t.hero.primary}
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12H20M14 6l6 6-6 6"></path></svg>
        </a>
        <a class="quiet" href="#runs">{t.hero.secondary}</a>
      </div>
      <p class="early">
        <svg class="lamp lamp--s" data-state="progress" aria-hidden="true"><use href="#l-progress"></use></svg>
        {t.hero.early}
      </p>
    </div>
    <div class="track" data-track>
      <div
        class="board"
        data-board
        role="img"
        aria-label={t.hero.boardLabel}
        data-clear-text={t.hero.clear}
        data-deploying-text={t.hero.deploying}
        data-problem-text={t.hero.problem}
        data-problems-text={t.hero.problems}
      >
        <div class="board__head" aria-hidden="true">
          <span class="gauge">
            <svg viewBox="0 0 100 100">
              <g fill="none" stroke-width="11" transform="rotate(-90 50 50)">
                <circle cx="50" cy="50" r="40" stroke="#2B3C63"></circle>
                <circle
                  data-arc
                  cx="50"
                  cy="50"
                  r="40"
                  stroke="#3DBFAE"
                  pathLength="360"
                  stroke-dasharray={`${(percent / 100) * 350.5} 360`}
                  stroke-dashoffset="-4.75"></circle>
                <circle cx="50" cy="50" r="40" stroke="#E3A33A" pathLength="360" stroke-dasharray="9.5 360" stroke-dashoffset="4.75"></circle>
              </g>
            </svg>
            <span data-percent>{percent}%</span>
          </span>
          <p class="board__word" data-word>{problems} {t.hero.problems}</p>
          <ul class="board__counts">
            {
              orderedStates.map((state) => (
                <li title={t.hero.states[state]}>
                  <svg class="lamp lamp--s" data-state={state}>
                    <use href={`#l-${state}`} />
                  </svg>
                  <span data-count={state}>{count(state)}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="board__grid" aria-hidden="true">
          {
            lamps.map((lamp) => (
              <span class="cell">
                <svg class="lamp" data-state={lamp.state} data-s={lamp.start} data-e={lamp.end}>
                  <use href={`#l-${lamp.state}`} />
                </svg>
              </span>
            ))
          }
        </div>
      </div>
    </div>
    <p class="hint" data-hint aria-hidden="true">{t.hero.scroll}</p>
  </div>
</section>

<section class="sec on-light glance">
  <div class="wrap grid">
    <div class="glance__text" data-reveal>
      <h2>{t.glance.title}</h2>
      <p>{t.glance.body}</p>
    </div>
    <figure class="glance__shot" data-shot>
      <div class="shot">
        <Image src={overview} alt={t.glance.alt} widths={[640, 1024, 1440]} sizes="(min-width: 1000px) 70vw, (min-width: 640px) 100vw, 190vw" format="webp" quality={82} loading="lazy" />
      </div>
      <figcaption>{t.glance.caption}</figcaption>
    </figure>
    <div class="legend" data-reveal>
      <ul>
        {
          orderedStates.map((state) => (
            <li>
              <svg class="lamp lamp--m" data-state={state} aria-hidden="true">
                <use href={`#l-${state}`} />
              </svg>
              {t.hero.states[state]}
            </li>
          ))
        }
      </ul>
      <p>{t.glance.rule}</p>
    </div>
  </div>
</section>

<section class="sec on-light paper" id="runs">
  <div class="wrap">
    <h2 class="runs__title" data-reveal>{t.runs.title}</h2>
    <ul class="rows">
      {
        t.runs.rows.map(([icon, name, detail]) => (
          <li data-reveal>
            <svg class="picto" viewBox="0 0 24 24" aria-hidden="true" set:html={pictograms[icon]} />
            <h3>{name}</h3>
            <p>{detail}</p>
            <svg class="lamp lamp--m rows__lamp" data-state="running" data-settle aria-hidden="true">
              <use href="#l-running" />
            </svg>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="sec on-light back">
  <div class="wrap grid">
    <figure class="back__shot" data-shot>
      <Image src={deployments} alt={t.back.alt} widths={[640, 1024, 1440]} sizes="(min-width: 1000px) 60vw, 100vw" format="webp" quality={82} loading="lazy" />
    </figure>
    <div class="back__text" data-reveal>
      <h2>{t.back.title}</h2>
      <p>{t.back.body}</p>
      <p class="muted">{t.back.failed}</p>
    </div>
  </div>
</section>

<section class="sec address">
  <div class="wrap">
    <div class="address__top grid">
      <h2 data-reveal>{t.address.title}</h2>
      <p data-reveal>{t.address.body}</p>
    </div>
    <p class="addr" data-reveal><span data-id>k7wqmd3r</span><span class="addr__zone">.opsifier.dev</span></p>
    <div class="address__foot">
      <button class="btn btn--line" type="button" data-another>{t.address.another}</button>
      <p class="address__note">{t.address.note}</p>
    </div>
  </div>
</section>

<section class="sec on-light roles">
  <div class="wrap grid">
    <div class="roles__text" data-reveal>
      <h2>{t.roles.title}</h2>
      <p>{t.roles.body}</p>
    </div>
    <div class="roles__ui" data-tabs>
      <div class="tabs" role="tablist" aria-label={t.roles.label}>
        {
          t.roles.items.map((item, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${item.id}`}
              aria-controls={`panel-${item.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
            >
              {item.name}
            </button>
          ))
        }
      </div>
      {
        t.roles.items.map((item, index) => (
          <div role="tabpanel" id={`panel-${item.id}`} aria-labelledby={`tab-${item.id}`} hidden={index !== 0} tabindex="0">
            <ul class="role">
              {item.rows.map((row) => (
                <li>
                  <svg class="lamp lamp--m" data-state={item.lock ? "stopped" : "running"} aria-hidden="true">
                    <use href={item.lock ? "#l-stopped" : "#l-running"} />
                  </svg>
                  {row}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="sec term">
  <div class="wrap grid">
    <div class="term__text" data-reveal>
      <h2>{t.terminal.title}</h2>
      <p>{t.terminal.body}</p>
    </div>
    <pre class="term__code" data-reveal role="group" aria-label={t.terminal.label}><code>{commands.map((line) => <span class="line"><span class="prompt" aria-hidden="true">$ </span>{line}{"\n"}</span>)}</code></pre>
  </div>
</section>

<section class="sec on-light status" id="status">
  <div class="wrap grid">
    <div class="status__text" data-reveal>
      <h2>{t.status.title}</h2>
      <p>{t.status.body}</p>
    </div>
    <div class="status__list" data-reveal>
      <h3>{t.status.worksTitle}</h3>
      <ul>
        {
          t.status.works.map((item) => (
            <li>
              <svg class="lamp lamp--m" data-state="running" aria-hidden="true"><use href="#l-running" /></svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="status__list" data-reveal>
      <h3>{t.status.notYetTitle}</h3>
      <ul>
        {
          t.status.notYet.map((item) => (
            <li>
              <svg class="lamp lamp--m" data-state="stopped" aria-hidden="true"><use href="#l-stopped" /></svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="sec start">
  <div class="wrap grid">
    <p class="status-line" data-reveal>
      <svg class="lamp lamp--m" data-state="running" aria-hidden="true"><use href="#l-running"></use></svg>
      {t.hero.clear}
    </p>
    <h2 data-reveal>{t.start.title.split(" ").map((word) => <><span class="word">{word}</span>{" "}</>)}</h2>
    <div class="start__body">
      <div class="start__text">
        <p>{t.start.body}</p>
        <a class="btn btn--amber" href={REPOSITORY} rel="noopener">
          {t.start.cta}
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12H20M14 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <div class="start__run">
        <h3 class="start__label">{t.start.serverTitle}</h3>
        <div class="code" data-code>
          <pre><code data-source>{install}</code></pre>
          <button class="copy" type="button" data-copy data-done={t.start.copied}>{t.start.copy}</button>
        </div>
        <p class="muted-navy">{t.start.serverNeeds}</p>
        <h3 class="start__label">{t.start.localTitle}</h3>
        <div class="code" data-code>
          <pre><code data-source>{start}</code></pre>
          <button class="copy" type="button" data-copy data-done={t.start.copied}>{t.start.copy}</button>
        </div>
        <p class="muted-navy">{t.start.needs}</p>
      </div>
    </div>
  </div>
</section>
