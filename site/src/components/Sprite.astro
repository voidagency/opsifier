---
// The panel's own state glyphs, on its 16-unit grid (apps/web/src/ui/visual/Lamp.tsx).
const check = "M4.6 8.7 5.8 7.5 7.3 9 10.5 5.8 11.7 7 7.3 11.4Z";
const exclamation = "M7.1 6h1.8v4.4H7.1ZM7.1 11.2h1.8v1.7H7.1Z";
const cross =
  "M8 6.95 9.85 5.1 10.9 6.15 9.05 8 10.9 9.85 9.85 10.9 8 9.05 6.15 10.9 5.1 9.85 6.95 8 5.1 6.15 6.15 5.1Z";
const disc = "M8 1.5A6.5 6.5 0 1 1 8 14.5 6.5 6.5 0 1 1 8 1.5Z";
const triangle = "M8 1.3 15.5 14.3H.5Z";
const diamond = "M8 .8 15.2 8 8 15.2 .8 8Z";
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="l-running" viewBox="0 0 16 16"><path d={disc + check} fill="currentColor" fill-rule="evenodd"></path></symbol>
  <symbol id="l-degraded" viewBox="0 0 16 16"><path d={triangle + exclamation} fill="currentColor" fill-rule="evenodd"></path></symbol>
  <symbol id="l-failed" viewBox="0 0 16 16"><path d={diamond + cross} fill="currentColor" fill-rule="evenodd"></path></symbol>
  <symbol id="l-progress" viewBox="0 0 16 16">
    <circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M8 4.25a3.75 3.75 0 0 1 0 7.5Z" fill="currentColor"></path>
  </symbol>
  <symbol id="l-stopped" viewBox="0 0 16 16">
    <circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <rect x="6" y="6" width="4" height="4" fill="currentColor"></rect>
  </symbol>
  <symbol id="l-unknown" viewBox="0 0 16 16">
    <circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="2" pathLength="32" stroke-dasharray="2.4 1.6" transform="rotate(-11.25 8 8)"></circle>
    <path d="M6.25 6.5A1.75 1.75 0 1 1 9.1 7.9C8.4 8.4 8 8.8 8 9.6" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <circle cx="8" cy="11.4" r=".95" fill="currentColor"></circle>
  </symbol>
</svg>
