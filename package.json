{
  "name": "opsifier",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@opsifier/server' --filter '@opsifier/web' dev",
    "build": "bun run --filter '@opsifier/web' build && bun run --filter '@opsifier/server' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "22",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild"
  ]
}
