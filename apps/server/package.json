{
  "name": "@opsifier/server",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "OPSIFIER_DRIVER=${OPSIFIER_DRIVER:-fake} tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --platform node --target node22 --out-dir dist && rm -rf dist/templates && cp -R ../../templates dist/templates",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@opsifier/contract": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "basic-ftp": "^6.2.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "nanoid": "^6.0.2",
    "otpauth": "^9.6.0",
    "pino": "^10.4.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^4.0.2",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
