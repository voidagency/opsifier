{
  "name": "@opsifier/cli",
  "version": "0.6.2",
  "license": "Apache-2.0",
  "description": "Command-line client for an Opsifier panel. Talks only to its API.",
  "keywords": [
    "opsifier",
    "cli",
    "self-hosted",
    "paas",
    "deploy",
    "docker",
    "swarm"
  ],
  "homepage": "https://opsifier.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidagency/opsifier.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/voidagency/opsifier/issues",
  "type": "module",
  "bin": {
    "opsifier": "dist/opsifier.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/opsifier.mjs \"--banner:js=#!/usr/bin/env node\" && chmod +x dist/opsifier.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@opsifier/client": "workspace:*",
    "@opsifier/contract": "workspace:*"
  }
}
